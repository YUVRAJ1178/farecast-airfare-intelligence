# ============================================================
# Airfare Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airfare_intelligence
POSTGRES_USER=airfare_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgresql://airfare_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/airfare_intelligence

# --- Amadeus API (optional — app works without these) ---
# Register at https://developers.amadeus.com/
AMADEUS_CLIENT_ID=YOUR_AMADEUS_CLIENT_ID_HERE
AMADEUS_CLIENT_SECRET=YOUR_AMADEUS_CLIENT_SECRET_HERE

# --- Application ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO
PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Demo Mode ---
# Set to true to use historical/demo data only (no live API calls)
DEMO_MODE=true
